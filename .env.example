# Salin file ini menjadi ".env" lalu sesuaikan. Jangan pernah mengunggah ".env" ke GitHub.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Alamat publik situs (dipakai untuk sitemap, RSS, canonical, dan tag Open Graph)
SITE_URL=https://example.com

# ============================================================
# Supabase — SATU-SATUNYA tempat penyimpanan data (lihat README.md > "Menyiapkan Supabase")
# ============================================================
# 1. Buat project baru di https://supabase.com/dashboard
# 2. Buka SQL Editor, tempel seluruh isi supabase/schema.sql, lalu jalankan (RUN)
# 3. Buka Project Settings -> API, salin "Project URL" dan "service_role secret" ke bawah ini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hanya dipakai sebagai tempat singgah SEMENTARA sebelum file diunggah ke Supabase Storage.
# Boleh dibiarkan bawaan; folder ini aman dikosongkan kapan saja, tidak ada data penting di sini.
UPLOAD_TMP_DIR=./uploads/tmp

# Kosongkan agar dibuat otomatis sekali dan disimpan di tabel kv_singles milik Supabase Anda
SESSION_SECRET=

# Isi 1 bila berjalan di belakang proxy/Nginx/Cloudflare agar IP asli terbaca
TRUST_PROXY=0
# true/false. Kosong = otomatis (secure bila HTTPS)
COOKIE_SECURE=

# Batas unggahan (MB)
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
MAX_DOC_MB=20
MAX_RESTORE_MB=2048

# Backup otomatis (ZIP seluruh tabel Supabase, disimpan di bucket Storage "backups")
BACKUP_AUTO=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

APP_TIMEZONE=Asia/Jakarta

# Hanya dipakai oleh "npm run init" saat pertama kali. Kosongkan agar kata sandi acak dicetak sekali.
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
